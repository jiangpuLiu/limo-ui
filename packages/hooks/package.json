{
  "name": "@limo-ui/hooks",
  "version": "0.0.1",
  "description": "Limo Ui composables",
  "license": "MIT",
  "author": "liujiangpu",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "src/index.ts",
  "module": "src/index.ts",
  "unpkg": "index.js",
  "jsdelivr": "index.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup src --dts",
    "dev": "tsup src --watch",
    "prepack": "clean-package",
    "postpack": "clean-package restore"
  },
  "clean-package": "../../clean-package.json",
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.0.1",
    "@limo-ui/constants": "^0.0.1",
    "@limo-ui/utils": "^0.0.1",
    "@popperjs/core": "npm:@sxzz/popperjs-es@^2.11.7",
    "@vueuse/core": "^9.1.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "lodash-unified": "^1.0.2",
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.6",
    "@types/node": "*",
    "clean-package": "^2.2.0"
  },
  "tsup": {
    "clean": true,
    "target": "es2018",
    "format": [
      "cjs",
      "esm"
    ]
  }
}
