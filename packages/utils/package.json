{
  "name": "@limo-ui/utils",
  "version": "0.0.1",
  "description": "Limo Ui shared utils",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "src/index.ts",
  "module": "src/index.ts",
  "unpkg": "index.js",
  "jsdelivr": "index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup src --dts",
    "dev": "tsup src --watch",
    "prepack": "clean-package",
    "postpack": "clean-package restore",
    "typecheck": "tsc --noEmit"
  },
  "clean-package": "../../clean-package.json",
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "dependencies": {
    "@limo-ui/constants": "workspace:*",
    "@vue/shared": "^3.2.0",
    "@vueuse/core": "^9.1.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "lodash-unified": "^1.0.2",
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.6",
    "@types/node": "*",
    "clean-package": "^2.2.0",
    "type-fest": "^3.6.0"
  },
  "tsup": {
    "clean": true,
    "target": "es2020",
    "format": [
      "cjs",
      "esm"
    ]
  }
}
