{
  "name": "@limo-ui/constants",
  "version": "0.0.1",
  "license": "MIT",
  "author": "liujiangpu",
  "files": [
    "dist"
  ],
  "main": "src/index.ts",
  "module": "src/index.ts",
  "unpkg": "index.js",
  "jsdelivr": "index.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup src --dts",
    "dev": "tsup src --watch",
    "prepack": "clean-package",
    "postpack": "clean-package restore",
    "typecheck": "tsc --noEmit"
  },
  "clean-package": "../../clean-package.json",
  "devDependencies": {
    "clean-package": "^2.2.0"
  },
  "tsup": {
    "clean": true,
    "target": "es2020",
    "format": [
      "cjs",
      "esm"
    ]
  }
}
