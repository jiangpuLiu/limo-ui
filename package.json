{
  "private": true,
  "packageManager": "pnpm@9.5.0",
  "workspaces": [
    "packages/*",
    "play",
    "docs"
  ],
  "scripts": {
    "dev": "pnpm -C play dev",
    "commit": "git add . && czg",
    "publish": "./scripts/publish.sh",
    "clean": "pnpm run clean:dist && pnpm run -r --parallel clean",
    "clean:dist": "rimraf dist",
    "clean:node_modules": "bash ./scripts/clear-nodemodules.sh",
    "build": "pnpm run -C internal/build start",
    "build:utils": "pnpm --filter @limo-ui/utils build",
    "build:hooks": "pnpm --filter @limo-ui/hooks build",
    "build:directives": "pnpm --filter @limo-ui/directives build",
    "build:constants": "pnpm --filter @limo-ui/constants build",
    "build:theme": "pnpm run -C packages/theme build",
    "format": "prettier --write --cache .",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx,.md,.json --max-warnings 0 --cache",
    "lint:fix": "pnpm run lint --fix",
    "lint:commit": "commitlint --from $(git merge-base origin/develope HEAD) --to HEAD > ./commit-lint.txt",
    "typecheck": "run-p typecheck:web typecheck:play typecheck:node typecheck:vite-config",
    "typecheck:web": "vue-tsc -p tsconfig.web.json --composite false --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:play": "vue-tsc -p tsconfig.play.json --composite false --noEmit",
    "typecheck:vite-config": "vue-tsc -p tsconfig.vite-config.json --composite false --noEmit",
    "docs:dev": "pnpm run -C docs dev",
    "docs:build": "pnpm run -C docs build",
    "stub": "pnpm run -r --parallel stub",
    "prepare": "husky",
    "postinstall": "pnpm stub"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.0.1",
    "@limo-ui/components": "workspace:*",
    "@limo-ui/constants": "workspace:*",
    "@limo-ui/directives": "workspace:*",
    "@limo-ui/hooks": "workspace:*",
    "@limo-ui/theme": "workspace:*",
    "@limo-ui/utils": "workspace:*",
    "@popperjs/core": "npm:@sxzz/popperjs-es@^2.11.7",
    "@types/lodash": "^4.14.182",
    "@types/lodash-es": "^4.17.6",
    "@vueuse/core": "^9.1.0",
    "async-validator": "^4.2.5",
    "dayjs": "^1.11.13",
    "escape-html": "^1.0.3",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "lodash-unified": "^1.0.2",
    "memoize-one": "^6.0.0",
    "normalize-wheel-es": "^1.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@esbuild-kit/cjs-loader": "^2.2.1",
    "@limo-ui/build": "workspace:*",
    "@limo-ui/build-utils": "workspace:*",
    "@limo-ui/eslint-config": "workspace:*",
    "@pnpm/find-workspace-packages": "^4.0.16",
    "@pnpm/logger": "^4.0.0",
    "@pnpm/types": "^8.4.0",
    "@types/fs-extra": "^9.0.13",
    "@types/gulp": "^4.0.9",
    "@types/jsdom": "^16.2.14",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^2.3.3",
    "@vitejs/plugin-vue-jsx": "^1.3.10",
    "@vue/test-utils": "^2.0.0",
    "@vue/tsconfig": "^0.1.3",
    "c8": "^7.11.3",
    "chalk": "^5.0.1",
    "clipboard-copy": "^4.0.1",
    "concurrently": "^7.2.2",
    "consola": "^2.15.3",
    "cross-env": "^7.0.3",
    "csstype": "^2.6.20",
    "cz-git": "^1.3.8",
    "czg": "^1.3.8",
    "eslint": "^8.57.1",
    "eslint-define-config": "^1.5.1",
    "expect-type": "^0.13.0",
    "fast-glob": "^3.2.11",
    "happy-dom": "^14.3.3",
    "husky": "^9.0.11",
    "jsdom": "16.4.0",
    "lint-staged": "^13.0.3",
    "lucide-vue-next": "^0.469.0",
    "mddir": "^1.1.1",
    "npm-run-all2": "^5.0.0",
    "prettier": "^2.7.1",
    "puppeteer": "^22.10.0",
    "resize-observer-polyfill": "^1.5.1",
    "rimraf": "^4.4.0",
    "sass": "^1.83.0",
    "tsup": "^8.3.5",
    "tsx": "^4.7.1",
    "type-fest": "^2.14.0",
    "typescript": "~5.5.4",
    "unplugin-vue-macros": "^2.14.5",
    "vue": "^3.2.37",
    "vue-router": "^4.0.16",
    "vue-tsc": "^2.0.28"
  },
  "engines": {
    "node": ">= 18"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-git"
    }
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "vite",
        "react",
        "react-dom"
      ]
    },
    "patchedDependencies": {
      "async-validator@4.2.5": "patches/async-validator@4.2.5.patch"
    }
  },
  "lint-staged": {
    "*.{vue,js,ts,jsx,tsx,md,json,mjs}": "eslint --fix"
  }
}
